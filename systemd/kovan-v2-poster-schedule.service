[Unit]
Description=Kovan V2 animated poster scheduled generation
Wants=network-online.target kovan-v2-poster-api.service
Requires=kovan-v2-poster-api.service
After=network-online.target kovan-v2-poster-api.service

[Service]
Type=oneshot
ExecStartPre=/bin/bash -lc 'for i in 1 2 3 4 5; do if curl -sfS http://127.0.0.1:8001/health >/dev/null 2>&1; then exit 0; fi; sleep 1; done; echo "Kovan V2 poster API is not responding on http://127.0.0.1:8001" >&2; exit 1'
ExecStart=/bin/bash -lc 'cd "/home/thansika/Documents/Content creation V2 animation" && set -a && source .env.poster-automation && set +a && POSTER_GENERATION_URL="http://127.0.0.1:8001/api/posters/generate" curl -sfS -X POST "http://127.0.0.1:8001/api/posters/cron" -H "Content-Type: application/json" -H "x-poster-schedule-secret: $POSTER_SCHEDULE_SECRET" -d "{}"'
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal
                                                                                                                                                                                                                                                                                            