# Kovan Poster Automation — environment template
# Copy to `.env.poster-automation` and fill in every required value.
# NOTE: `.env.poster-automation` contains secrets — it is git-ignored. Never commit it.

# Supabase project reference (the suffix in your project URL, e.g. abcdefghijklmnop)
SUPABASE_PROJECT_REF=your-supabase-project-ref
# OR provide the full URL explicitly instead of deriving it:
# SUPABASE_URL=https://<project-ref>.supabase.co

# Service role key (server-side only, keep secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth secrets for the two internal endpoints
POSTER_SCHEDULE_SECRET=generate-a-random-secret
POSTER_INTERNAL_API_SECRET=generate-a-random-secret

# Path or name of the Chrome binary used for headless rendering
CHROME_BINARY=google-chrome

# Local endpoint URLs (the systemd timer calls the schedule endpoint)
POSTER_SCHEDULE_URL=http://127.0.0.1:8001/api/posters/cron
POSTER_GENERATION_URL=http://127.0.0.1:8001/api/posters/generate

# Optional: Power Automate webhook URL. If empty, posters are generated
# and stored but NOT delivered to Outlook/Teams.
TEAMS_WEBHOOK_URL=

# Optional: Outlook "To" address (or a distribution list) for the Power
# Automate Send-an-email step. Leave empty if the flow hard-codes To.
POSTER_EMAIL_TO=
